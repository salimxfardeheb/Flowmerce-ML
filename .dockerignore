# ─── Secrets — JAMAIS dans l'image ────────────────────────────────
.env
.env.*
!.env.example
*.env
api/.env

# ─── Données volumineuses ─────────────────────────────────────────
# data/processed/splits_encoded.pkl (~68 Mo) ne sert qu'à l'entraînement.
# data/raw est conservé : /save_claim y écrit les réclamations réelles.
data/processed/

# NB : models/ est volontairement INCLUS dans l'image (~3 Mo) pour servir
# de repli local aux artefacts chargés depuis Hugging Face.

# ─── Python ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ─── Git / CI ─────────────────────────────────────────────────────
.git/
.gitignore
.github/

# ─── Docker ───────────────────────────────────────────────────────
Dockerfile
Dockerfile.prod
Dockerfile.prod.dockerignore
docker-compose.yml
docker-compose.prod.yml
.dockerignore

# ─── Logs & artefacts d'exécution ─────────────────────────────────
logs/
*.log

# ─── Tests — inutiles au runtime ──────────────────────────────────
tests/
requirements-dev.txt

# ─── Documentation & IDE / OS ─────────────────────────────────────
*.md
config_entrainement_*.txt
.claude/
.vscode/
.idea/
*.swp
