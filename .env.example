INTERNAL_API_KEY=flowmerce123

# Dataset sur Hugging Face Hub (repo de type "dataset").
# Si vide / absent, le pipeline utilise le CSV local data/raw/.
HF_DATASET_REPO=username/flowmerce-dataset
HF_DATASET_FILE=ecommerce_returns_smart_dataset.csv

# Token Hugging Face (https://huggingface.co/settings/tokens)
# Requis si le dataset est privé. Sert aussi à scripts/push_to_hub.py.
HF_TOKEN=

# Repo modèle pour scripts/push_to_hub.py
HF_REPO_ID=username/flowmerce-resolution-model
